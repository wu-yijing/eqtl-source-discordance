# --- newline handling -------------------------------------------------------
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.R    text eol=lf
*.r    text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Data and run logs (added 2026-10-02). Listed explicitly, like the types above,
# because `metadata/provenance.json` records a SHA-256 per file: if the checked-out
# bytes differ between platforms the manifest would appear to fail for no reason.
# With `eol=lf` the working copy and the stored blob are byte-identical everywhere.
*.csv  text eol=lf
*.tsv  text eol=lf
*.txt  text eol=lf

*.bat  text eol=crlf
*.ps1  text eol=crlf

# --- shipped upstream artefacts (added 2026-10-03) --------------------------
# `data/upstream/` carries the as-produced bytes of `code/run_upstream.sh`, so a
# reader can verify the Z layer's provenance without the ~7.5 GB of third-party
# inputs. They must be stored VERBATIM, not newline-normalised: the official
# MetaXcan CSV outputs are CRLF, and the MD5s in
# `code/upstream/verify_middleware.py` and `data/external/README.md` are hashes
# of those CRLF bytes. Normalising them to LF would make a fresh clone fail its
# own hash check — the same class of bug this archive already hit once and
# recorded against `data/external/SHA256SUMS` on 2026-10-02. `-text` also keeps
# git from sniffing the SQLite model databases.
data/upstream/** -text

# --- binary / do not diff ---------------------------------------------------
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.tif  binary
*.tiff binary
*.svg  text
*.xlsx binary
*.docx binary

# --- large-file handling ----------------------------------------------------
# Figures and derived tables are small enough to track directly. If a future
# artefact exceeds ~20 MB, route it through Git LFS by uncommenting and
# extending the patterns below, and record the object in data/README.md.
# *.pdf filter=lfs diff=lfs merge=lfs -text
# *.h5  filter=lfs diff=lfs merge=lfs -text

# --- linguist: keep the archive out of language statistics ------------------
data/derived/*.csv linguist-generated=true
figures/*.svg      linguist-generated=true
